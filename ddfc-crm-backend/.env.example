# Copy this file to .env and fill in real values. Never commit .env.

# Postgres connection. Either set DATABASE_URL, or the individual PG* vars below.
DATABASE_URL=postgres://ddfc_user:changeme@localhost:5432/ddfc_crm
# PGHOST=localhost
# PGPORT=5432
# PGDATABASE=ddfc_crm
# PGUSER=ddfc_user
# PGPASSWORD=changeme

# Set to require SSL when connecting (e.g. "true" for most managed Postgres hosts like RDS, Supabase, Render)
PGSSL=false

# Long random string used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-this-with-a-long-random-string

# How long a login session stays valid
JWT_EXPIRES_IN=12h

# Port the API server listens on
PORT=4000

# Comma-separated list of origins allowed to call the API from the browser
# (the URL(s) the CRM front-end is served from)
CORS_ORIGIN=http://localhost:5500,http://127.0.0.1:5500
